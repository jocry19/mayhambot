# Copy to .env and adjust. Everything works WITHOUT keys (DexScreener, GeckoTerminal, public Solana RPC).

# --- optional keys (better coverage / speed) ---
# Helius: wallet history via enhanced API + fast RPC (free tier at helius.dev)
HELIUS_API_KEY=
# Any other RPC (QuickNode, Triton ...). Overrides the Helius/public RPC.
SOLANA_RPC_URL=

# --- Telegram signals (only active when both are set) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- storage ---
# MAYHAM_DB_PATH=data/mayhambot.db

# --- discovery / tracking ---
MIN_LIQUIDITY_USD=8000
MAX_MCAP_USD=50000000
MAX_TRACKED_TOKENS=25
CYCLE_SECONDS=90
DISCOVER_EVERY_CYCLES=5

# --- smart-wallet scoring ---
SMART_MIN_SCORE=55          # wallet score 0-100 needed to count as smart
SMART_MIN_TOKENS=2          # min. coins with a real position (>= MIN_POSITION_USD)
MIN_POSITION_USD=25
EARLY_HIT_MULTIPLE=2.0      # "early entry" = price later reached >= 2x the entry
BOT_MAX_TRADES_PER_TOKEN=40
BACKFILL_WALLETS_PER_CYCLE=3
BACKFILL_TX_LIMIT=60

# --- signals ---
SIGNAL_WINDOW_MIN=30
SIGNAL_MIN_SCORE=60
SIGNAL_MIN_WALLETS=2
SIGNAL_MIN_NET_USD=500
# effective net minimum = min(SIGNAL_MIN_NET_USD, SIGNAL_MIN_WALLETS x median Smart buy of the last 24h), never below this
SIGNAL_NET_FLOOR_USD=100
SIGNAL_COOLDOWN_MIN=60
INFLOW_REF_USD=5000         # net inflow at which the money part is ~63% saturated
WALLETS_REF_COUNT=4         # smart buyers at which the breadth part is ~63% saturated

# --- dashboard ---
# WEB_PORT=8600
# WEB_HOST=127.0.0.1   # 0.0.0.0 = auch von Handy/anderen Geräten im WLAN erreichbar
# with model/ active the score is P(pump in 1h) x 100; signal threshold for that case
MODEL_SIGNAL_MIN_SCORE=40
# model threshold = min(MIN_SCORE, LIFT x base rate of the active model's 1h horizon), never below FLOOR
MODEL_SIGNAL_MIN_LIFT=2.0
MODEL_SIGNAL_FLOOR=10
# seconds per cycle spent fetching pool trades (GeckoTerminal is rate limited; the rest follows next cycle)
TRADES_BUDGET_SECONDS=150

# --- market analysis (market/, service "market"; keyless, no Helius credits) ---
# MARKET_EVERY_SEC=300
# MARKET_DEXSCREENER_PER_MIN=20     # own budget of the market service
# MARKET_COINGECKO_PER_MIN=4
# off until market.evaluate shows a clear difference (dashboard page "Markt"):
MARKET_SIGNAL_WEIGHT=false          # signal score x (1 +- MARKET_SIGNAL_MAX_ADJ) from phase and sector heat
MARKET_SNIPER_GATE=false            # risk-off: sniper min score +10, hot narrative: -5
MARKET_LEARNED_WEIGHTS=false        # phase weights learned walk-forward (adopted only if better out of sample)
# MARKET_DYNAMICS_EVERY_SEC=3600
